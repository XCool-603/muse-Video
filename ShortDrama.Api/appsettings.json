{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "_Urls": "不要在这里设置 Urls —— appsettings 会覆盖 ASPNETCORE_URLS 环境变量，导致容器内监听 localhost 而无法从外部访问。本地开发端口见 Properties/launchSettings.json，容器端口由 Dockerfile 的 ASPNETCORE_URLS 决定。",
  "AccessGate": {
    "enabled": true,
    "password": "遵纪守法世界和平",
    "cookieName": "sd_access",
    "validDays": 30,
    "gatePath": "/gate",
    "verifyPath": "/api/v1/access",
    "_comment": "私有实例入口口令。通过后签发 HttpOnly Cookie，有效期 validDays 天。Cookie 存的是口令的 SHA256 派生值，不含明文；改口令即让所有已发放 Cookie 失效。"
  },
  "Demo": {
    "Enabled": false,
    "_comment": "false = 只使用真实源（apple-cms-sources.json + 黄豆 hddj.tv）；true = 额外启用内置模拟数据"
  },
  "HongGuoWeb": {
    "enabled": true,
    "platformCode": "hongguo",
    "platformName": "红果短剧",
    "baseUrl": "https://hongguoduanju.com",
    "timeoutSeconds": 20,
    "_comment": "抖音/番茄系官方 H5。目录（榜单/分类/详情）服务端渲染可索引；视频为 MP4 CENC DRM 加密，服务端无法播放；搜索为纯前端实现，走本地索引兜底",
    "hotRankPath": "/rank/hot-drama",
    "realDramaRankPath": "/rank/hot-real-drama",
    "latestRankPath": "/rank/hot-ai-drama",
    "defaultCategoryPath": "/category/real-drama",
    "categoryPaths": {
      "全部": "/category/real-drama",
      "短剧": "/category/real-drama",
      "真人剧": "/category/real-drama",
      "漫剧": "/category/comic-drama",
      "AI剧": "/category/ai-drama",
      "漫画": "/category/comic"
    }
  },
  "HuangGuoAi": {
    "enabled": true,
    "platformCode": "huangguo",
    "platformName": "黄果短剧",
    "baseUrl": "https://huangguodrama.ai",
    "mediaBaseUrl": "https://media.huangguodrama.ai",
    "timeoutSeconds": 20,
    "requestsPerMinute": 50,
    "excludeAdult": false,
    "fullCatalogSync": true,
    "maxCatalogPages": 30,
    "_comment": "站点公开的 catalog API（robots.txt Allow + OpenAPI 规范，只读，官方限流 60/min）；视频为明文 MP4（无 DRM/鉴权，CORS 全开）。excludeAdult=true 可按标题关键词过滤成人向内容。fullCatalogSync=true 时按页遍历全量目录（约 513 部），而非仅按关键词播种。"
  },
  "HuangDou": {
    "enabled": true,
    "platformCode": "huangdou",
    "platformName": "黄豆短剧",
    "baseUrl": "https://hddj.tv",
    "timeoutSeconds": 15,
    "_comment": "详情页路径与 data-ep-src/data-ep-free 属性来自公开逆向文档（已确认）；searchPathCandidates / listPathCandidates 未经确认，靠探测，失败时看日志提示",
    "detailPathCandidates": ["/watch/details/{id}", "/series/details/{id}"],
    "detailLinkPrefix": "/watch/details",
    "searchPathCandidates": [
      "/api/search?keyword={kw}&page={page}&pageSize={pageSize}",
      "/api/drama/search?keyword={kw}&page={page}&pageSize={pageSize}",
      "/search?keyword={kw}&page={page}",
      "/search?q={kw}&page={page}",
      "/api/v1/search?kw={kw}&page={page}"
    ],
    "listPathCandidates": [
      "/api/drama/list?page=1&pageSize=20",
      "/api/dramas?page=1&pageSize=20",
      "/series",
      "/list"
    ]
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=shortdrama.db",
    "_PostgreSql": "Host=localhost;Database=shortdrama;Username=admin;Password=xxx",
    "_MySql": "Server=localhost;Database=shortdrama;User=root;Password=xxx"
  },
  "Jwt": {
    "Key": "ShortDrama-Aggregation-Platform-Secret-Key-Please-Change-In-Production-2025",
    "Issuer": "ShortDrama",
    "Audience": "ShortDramaClient",
    "ExpireHours": 168
  }
}
