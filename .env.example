# ============================================================================
# 部署环境变量
#
#   cp .env.example .env
#   然后按需修改 .env
#
# .env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================================

# 对外端口
APP_PORT=8080

# ---- 部署模式 ----
# 留空 = 源码模式：在本机构建镜像（首次约 3-5 分钟，更新也要重新编译）
# 填地址 = 镜像模式：直接拉 GHCR 上的预构建镜像，本机不编译，更新只要几秒
#   仓库已配好 GitHub Actions 自动构建（见 .github/workflows/docker-publish.yml）
#   镜像地址形如：ghcr.io/<你的用户名小写>/<仓库名小写>:latest
# 若该包在 GitHub 上是私有的，拉取前需要先登录：
#   echo <你的PAT> | docker login ghcr.io -u <用户名> --password-stdin
# SHORTDRAMA_IMAGE=ghcr.io/xcool-603/muse-video:latest

# ---- 访问口令门 ----
# true = 进入网站前需输入口令
ACCESS_GATE_ENABLED=true
ACCESS_PASSWORD=遵纪守法世界和平

# ---- JWT 密钥 ----
# 生产环境务必替换成随机字符串。生成方式：
#   pwsh:  -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#   bash:  openssl rand -hex 48
JWT_KEY=please-change-this-secret-key-in-production-2025

# ---- 仅 PostgreSQL 覆盖配置使用 ----
POSTGRES_PASSWORD=shortdrama_pwd
