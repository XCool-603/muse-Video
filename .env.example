# ============================================================================
# 部署环境变量
#
#   cp .env.example .env
#   然后按需修改 .env
#
# .env 已被 .gitignore 忽略，不会提交到仓库。
# ============================================================================

# 对外端口
APP_PORT=8080

# ---- 访问口令门 ----
# true = 进入网站前需输入口令
ACCESS_GATE_ENABLED=true
ACCESS_PASSWORD=遵纪守法世界和平

# ---- JWT 密钥 ----
# 生产环境务必替换成随机字符串。生成方式：
#   pwsh:  -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
#   bash:  openssl rand -hex 48
JWT_KEY=please-change-this-secret-key-in-production-2025

# ---- 仅 PostgreSQL 覆盖配置使用 ----
POSTGRES_PASSWORD=shortdrama_pwd
